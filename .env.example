# 知澜源码运行示例：复制为仓库根目录 .env，再启动应用。
# 此文件不含凭据。聊天和 Embedding 服务优先在设置页配置。
# 本机 .env 不要提交仓库；配置、资料和日志目录需要写入权限。

# SQLite + 本地 Qdrant：不需要 Docker 或外部数据库服务。
DB_BACKEND=sqlite
# 留空使用 data/zhilan.db。
SQLITE_PATH=
QDRANT_URL=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=zhilan_chunks
UPLOAD_DIR=data/uploads
PORT=8000

# Embedding 返回的维度必须与这里一致；更换模型或维度后重建相关索引。
EMBED_DIM=1024

# 设置页保存服务注册表和角色绑定；已有注册表时不要只改下面的旧式扁平键。
MODEL_SERVICES=
MODEL_ROLES=
MODEL_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBED_PROVIDER=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
VISION_MODEL=

# 源码基本依赖不含完整 OCR 运行时。启用前另行准备兼容运行时与模型。
# Windows 安装包使用自己的桌面默认配置并启用离线解析。
MINERU_ENABLE=false
MINERU_DEVICE=cpu
MINERU_BACKEND=auto
MINERU_MODEL_DIR=
MINERU_VLM_ENABLE=false
OCR_IMAGE_ENABLE=true

# 文件工具默认关闭；设置工作区根目录后才启用相应文件工具。
WORKSPACE_ROOT=

# 联网功能默认关闭。以下键需要改 .env 后重启，设置页不能写入。
WEB_ENABLE=false
WEB_CHANNEL=api
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
# 一般保持 false；开启后允许私网或本机地址，界面不显示该开关。
WEB_SSRF_ALLOW_ANY_HOST=false
# 单次搜索的抓取预算，单位秒；0 表示不限制预算。
WEB_SEARCH_BUDGET_SECONDS=20

# MCP 配置为 JSON 数组；包许可和 HTTP 外发许可使用逗号分隔的精确 slug。
# 默认不发现、不允许使用外部 MCP 包；请只添加自己信任并确需使用的服务。
MCP_SERVERS=
MCP_ALLOW_SERVERS=
MCP_ALLOW_EGRESS=
