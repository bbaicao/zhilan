# 知澜 · 桌面默认配置
# 安装程序会在**首次安装**时把它写为 <安装目录>\.env；**升级安装不会覆盖**（你改过的内容留得住）。
# 本文件不含任何密钥；真实 API Key 请在程序里的「设置」页填写（设置页写回安装目录的 .env）。
# 当前版本连接免鉴权的本机服务也需要非空占位 Key，例如 ollama；有鉴权的服务填写真实 Key。
# 改完直接重启程序即可生效。

# ── 数据层（桌面档：SQLite + 内嵌向量库，不需要另外装数据库或服务）──
DB_BACKEND=sqlite
SQLITE_PATH=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=zhilan_chunks
EMBED_DIM=1024
UPLOAD_DIR=data/uploads

# 文档内容相似时自动连线；导入或重建索引完成后生成。
GRAPHLINK_ENABLE=true

# ── 工作区根（只读文件工具的边界根；专项工具升级-3 · 阶段 3）──
# 留空 = **不启用**文件工具（出厂档 0：不注册 list_files / read_file / grep_files）。
# 要启用：在「设置」页填写工作区根目录（设置页会写回本文件），或在此填一个绝对路径。
# 用了之后，模型只能看这个根**以内**的文件：相对路径一律相对它解析（绝不取进程工作目录）；
# 越界路径会被边界层直接拒绝（敏感目录如 .git / data / alembic 也在拒绝之列）。
# 写入另需有效的专用确认机制；当前默认配置和界面没有接入完整写入审批。
WORKSPACE_ROOT=

# ── 文档解析（MinerU）──
# ⚠️ `MINERU_ENABLE` **必须为 true** 才会真的走 MinerU（PDF 的扫描件分流 + 图片 OCR 都挂在它下面）；
#    代码里的兜底默认是 **false**（开发态"一律 pypdf、不 import 重依赖"），桌面档必须显式打开——
#    否则**导入模型包等于白导**：扫描件拿不到 OCR，只会报「该 PDF 未提取到文字」。
MINERU_ENABLE=true
MINERU_DEVICE=cpu
MINERU_VLM_ENABLE=false

# ── 服务端口（被占用时程序会自动往后找空闲端口）──
PORT=8000

# ── 模型 HOME 与导入目录 ──
# 桌面启动器默认将 MINERU_HOME 设为可执行文件所在目录，模型位于其下的 models 子目录。
# 用户已有的系统环境变量 MINERU_HOME 优先；要把模型放到别处，设为包含 models 子目录的 HOME 根目录，
# 不是现有 models 子目录。导入器会追加 models/MinerU-4_models_onnx，以导入面板显示的路径为准。
# 安装程序可能追加 MINERU_MODEL_DIR 兼容声明；它不覆盖启动器或系统环境变量设置的 MINERU_HOME。

WEB_SSRF_ALLOW_ANY_HOST=false

WEB_SEARCH_BUDGET_SECONDS=20
